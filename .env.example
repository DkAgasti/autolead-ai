# Google Gemini API
GEMINI_API_KEY=your_gemini_key

# Native Gmail SMTP (Outbound) & IMAP (Inbound) Engine (Direct Protocol, No 3rd Party APIs)
# IMPORTANT: Generate a 16-character App Password at: https://myaccount.google.com/apppasswords
EMAIL_USER=your_email@gmail.com
EMAIL_APP_PASSWORD=your_16_char_google_app_password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
SENDER_NAME=Alex Rivera

# Outbound Pitch Profile Defaults
PORTFOLIO_URL=https://alexrivera.dev
CALENDLY_URL=https://calendly.com/alexrivera/30min

# Database
DATABASE_URL=sqlite:///./autolead.db

# Inbound Auto-Reply Configuration
# 'manual' = drafts replies and sets status to NEEDS_REVIEW for human approval
# 'autonomous' = drafts and automatically dispatches replies to interested leads
AUTO_REPLY_MODE=manual

# Throttling & Scheduling
DAILY_SCRAPE_TIME_IST=10:00
EMAIL_THROTTLE_MIN_SEC=45
EMAIL_THROTTLE_MAX_SEC=90

